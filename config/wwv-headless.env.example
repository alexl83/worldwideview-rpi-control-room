# Install as /etc/wwv-headless.env, owned by root and mode 0600.
WWV_BROWSER_URL=http://127.0.0.1:3000
WWV_BROWSER_PROFILE=/var/lib/wwv-browser/profile
WWV_BROWSER_EMAIL=admin@example.invalid
WWV_BROWSER_PASSWORD=replace-me
CHROMIUM_PATH=/usr/bin/chromium
# A stable UUID lets the MCP agent recognize this browser as its fallback session.
WWV_HEADLESS_SESSION_ID=00000000-0000-4000-8000-000000000001
