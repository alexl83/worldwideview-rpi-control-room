# Install as /etc/wwv-agent.env, owned by root and mode 0600.
WWV_AGENT_ALLOWED_NUMBERS=15551234567,15557654321
# Optional opaque WhatsApp LIDs observed when Baileys supplies no phone-number alias.
WWV_AGENT_ALLOWED_IDENTITIES=
WWV_AGENT_ADMIN_NUMBERS=15551234567
WWV_AGENT_ADMIN_IDENTITIES=
WWV_AGENT_GEOCODER_URL=https://nominatim.openstreetmap.org/search
WWV_AGENT_STATE_DIR=/var/lib/wwv-agent
WWV_AGENT_WORKSPACE=/srv/worldwideview
WWV_AGENT_ENGINE_URL=http://127.0.0.1:5000
WWV_AGENT_MONITORS_FILE=/etc/wwv-monitors.json
WWV_AGENT_FRONTEND_SOCKET=/run/wwv-agent/chat.sock
WWV_AGENT_SOCKET_TOKEN=replace-with-a-long-random-shared-secret
# Must match WWV_HEADLESS_SESSION_ID in /etc/wwv-headless.env.
WWV_AGENT_HEADLESS_SESSION_ID=00000000-0000-4000-8000-000000000001
# Leave unset to follow the authenticated Codex CLI default.
# WWV_AGENT_MODEL=
WWV_AGENT_MAX_MESSAGE_CHARS=12000
WWV_AGENT_TIMEOUT_MS=600000
# Set to 86400 for 24-hour disappearing replies and monitor alerts; 0 disables it.
WWV_AGENT_EPHEMERAL_EXPIRATION_SECONDS=0
# Voice notes are transcribed and answered with both text and Italian speech.
# Written messages remain text-only.
WWV_AGENT_WHISPER_PATH=/opt/wwv-voice/whisper/whisper-cli
WWV_AGENT_WHISPER_MODEL=/opt/wwv-voice/models/ggml-base.bin
WWV_AGENT_PIPER_PYTHON=/opt/wwv-voice/piper/bin/python3
WWV_AGENT_PIPER_MODEL=/opt/wwv-voice/models/it_IT-paola-medium.onnx
WWV_AGENT_FFMPEG_PATH=/usr/bin/ffmpeg
WWV_AGENT_VOICE_MAX_SECONDS=180
WWV_AGENT_VOICE_MAX_BYTES=12582912
WWV_AGENT_VOICE_MAX_SPEECH_CHARS=4000
LOG_LEVEL=info
