# Install as /etc/worldwideview.env, owned by root and mode 0600.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=https://your-pi.local
BETTER_AUTH_URL=https://your-pi.local
# Keep application ports private; Caddy is the only LAN-facing entry point.
WWV_BIND=127.0.0.1
WWV_ENGINE_BIND=127.0.0.1
GOOGLE_MAPS_API_KEY=replace-me
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-me
WWV_AGENT_SOCKET_TOKEN=replace-with-the-same-secret-as-wwv-agent.env
