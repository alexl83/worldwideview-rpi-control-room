[Unit]
Description=WorldWideView persistent headless globe session
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=@WWV_USER@
Group=@WWV_USER@
SupplementaryGroups=render video
WorkingDirectory=/opt/wwv-headless
Environment=HOME=@WWV_HOME@
EnvironmentFile=/etc/wwv-headless.env
ExecStart=/usr/bin/node /opt/wwv-headless/keeper.mjs
Restart=always
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wwv-browser
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
